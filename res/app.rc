#include <windows.h>

// 清单由运行时 API 设置 DPI，避免与 MinGW 默认清单冲突
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,3,0
PRODUCTVERSION  1,1,3,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "Lazuli"
            VALUE "FileDescription",  "Lazuli Launcher - Minecraft Java Edition Launcher"
            VALUE "FileVersion",      "1.1.3.0"
            VALUE "InternalName",     "LazuliLauncher"
            VALUE "OriginalFilename", "LazuliLauncher.exe"
            VALUE "ProductName",      "琉璃启动器"
            VALUE "ProductVersion",   "1.1.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
